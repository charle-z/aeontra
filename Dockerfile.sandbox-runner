FROM golang:1.26.6-alpine3.24@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/mcp-sandbox-runner ./cmd/mcp-sandbox-runner
COPY internal/policy ./internal/policy
COPY internal/sandboxexecutor ./internal/sandboxexecutor
COPY internal/sandboxprotocol ./internal/sandboxprotocol
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/mcp-sandbox-runner ./cmd/mcp-sandbox-runner

FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d
RUN apk add --no-cache ca-certificates podman && addgroup -g 10001 runner && adduser -D -u 10001 -G runner runner
COPY --from=build /out/mcp-sandbox-runner /usr/local/bin/mcp-sandbox-runner
USER runner:runner
ENTRYPOINT ["/usr/local/bin/mcp-sandbox-runner"]
