[Unit]
Description=MCP Devbox official signed installation repair
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
ExecStart=/usr/local/libexec/mcp-devbox/mcp-bundle-updater repair
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/mcp-devbox /etc/systemd/system /usr/local/bin /usr/local/libexec/mcp-devbox
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
