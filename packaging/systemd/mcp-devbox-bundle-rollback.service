[Unit]
Description=MCP Devbox signed bundle rollback

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
ExecStart=/usr/local/libexec/mcp-devbox/mcp-bundle-updater rollback
TimeoutStartSec=5min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/mcp-devbox
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
