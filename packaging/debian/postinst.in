#!/bin/sh
set -eu

RELEASE='@RELEASE@'
ROOT='/opt/mcp-devbox'
RELEASE_ROOT="$ROOT/releases/$RELEASE"
CURRENT_NEXT="$ROOT/.current.next"
OLD_TARGET=''
LEGACY_PROVIDER="$ROOT/opencode-provider"
LEGACY_PROVIDER_BACKUP="$ROOT/.p15-migration-opencode-provider"
LEGACY_OPENCODE="$ROOT/opencode-1.18.1"
LEGACY_OPENCODE_BACKUP="$ROOT/.p15-migration-opencode-1.18.1"
MIGRATED_PROVIDER=0
MIGRATED_OPENCODE=0
EDGE_USER=''
EDGE_HOME=''
STATE_MIGRATION_PREPARED=0
EDGE_UNIT_BASE=''
ATTEMPTED_EDGE_UNIT_BASE=''

test "$(id -u)" -eq 0
test -f "$RELEASE_ROOT/manifest.json"
test -f "$RELEASE_ROOT/manifest.sig"

if [ -L "$ROOT/current" ]; then
  OLD_TARGET="$(readlink "$ROOT/current")"
fi

stage_legacy_directory() {
  legacy_path="$1"
  backup_path="$2"

  if [ -e "$backup_path" ] || [ -L "$backup_path" ]; then
    echo "stale MCP Devbox migration backup: $backup_path" >&2
    exit 1
  fi
  if [ -L "$legacy_path" ] || [ ! -e "$legacy_path" ]; then
    return 1
  fi
  if [ ! -d "$legacy_path" ]; then
    echo "MCP Devbox compatibility path is not a directory: $legacy_path" >&2
    exit 1
  fi
  mv "$legacy_path" "$backup_path"
  return 0
}

edge_lifecycle() {
  operation="$1"
  runuser -u "$EDGE_USER" -- env HOME="$EDGE_HOME" /usr/local/bin/mcp-edge lifecycle "$operation"
}

write_edge_home_dropins() {
  service_dropin_dir="/etc/systemd/system/${EDGE_UNIT_BASE}@${EDGE_USER}.service.d"
  path_dropin_dir="/etc/systemd/system/mcp-devbox-edge-onboard@${EDGE_USER}.path.d"
  state_root="$EDGE_HOME/.local/state/mcp-edge"

  install -d -m 0755 "$service_dropin_dir" "$path_dropin_dir"
  {
    printf '%s\n' '[Unit]' 'ConditionPathExists='
    printf 'ConditionPathExists=%s/identity.json\n' "$state_root"
    printf 'ConditionPathExists=!%s/STOP\n' "$state_root"
    printf '%s\n' '' '[Service]'
    printf 'WorkingDirectory=%s\n' "$state_root"
    printf 'Environment=HOME=%s\n' "$EDGE_HOME"
    printf '%s\n' 'ReadWritePaths='
    printf 'ReadWritePaths=%s %s/workspaces %s/htb-machines\n' "$state_root" "$EDGE_HOME" "$EDGE_HOME"
  } >"$service_dropin_dir/10-edge-home.conf"
  {
    printf '%s\n' '[Path]' 'PathExists='
    printf 'PathExists=%s/identity.json\n' "$state_root"
  } >"$path_dropin_dir/10-edge-home.conf"
  chmod 0644 "$service_dropin_dir/10-edge-home.conf" "$path_dropin_dir/10-edge-home.conf"
}

remove_official_link() {
  destination="$1"
  target="$2"
  if [ -L "$destination" ] && [ "$(readlink "$destination")" = "$target" ]; then
    rm -f "$destination"
  fi
}

install_edge_generation() {
  release_root="$1"
  path_next='/etc/systemd/system/.mcp-devbox-edge-onboard@.path.next'
  if [ -f "$release_root/systemd/mcp-devbox-edge@.service" ] && [ ! -L "$release_root/systemd/mcp-devbox-edge@.service" ]; then
    test -f "$release_root/systemd/mcp-devbox-edge-onboard@.path"
    test ! -L "$release_root/systemd/mcp-devbox-edge-onboard@.path"
    EDGE_UNIT_BASE='mcp-devbox-edge'
    install -m 0644 "$release_root/systemd/mcp-devbox-edge@.service" /etc/systemd/system/mcp-devbox-edge@.service
    install -m 0644 "$release_root/systemd/mcp-devbox-edge-onboard@.path" "$path_next"
  elif [ -f "$release_root/systemd/mcp-devbox-opencode-edge@.service" ] && [ ! -L "$release_root/systemd/mcp-devbox-opencode-edge@.service" ]; then
    EDGE_UNIT_BASE='mcp-devbox-opencode-edge'
    install -m 0644 "$release_root/systemd/mcp-devbox-opencode-edge@.service" /etc/systemd/system/mcp-devbox-opencode-edge@.service
    {
      printf '%s\n' '[Unit]' 'Description=Start MCP Devbox Edge when identity exists for %i' '' '[Path]'
      printf '%s\n' 'PathExists=/home/%i/.local/state/mcp-edge/identity.json' 'Unit=mcp-devbox-opencode-edge@%i.service' '' '[Install]' 'WantedBy=multi-user.target'
    } >"$path_next"
    chmod 0644 "$path_next"
  else
    echo 'signed Edge unit is unavailable' >&2
    return 1
  fi
  mv -f "$path_next" /etc/systemd/system/mcp-devbox-edge-onboard@.path
}

restore_legacy_directory() {
  legacy_path="$1"
  backup_path="$2"
  migrated="$3"

  if [ "$migrated" -eq 1 ] && [ -d "$backup_path" ]; then
    rm -f "$legacy_path"
    mv "$backup_path" "$legacy_path"
  fi
}

rollback_install() {
  if [ "$STATE_MIGRATION_PREPARED" -eq 1 ] && [ -n "$EDGE_USER" ]; then
    if ! edge_lifecycle rollback-state-migration; then
      echo 'MCP Devbox Edge state rollback requires manual recovery' >&2
    fi
  fi
  restore_legacy_directory "$LEGACY_PROVIDER" "$LEGACY_PROVIDER_BACKUP" "$MIGRATED_PROVIDER"
  restore_legacy_directory "$LEGACY_OPENCODE" "$LEGACY_OPENCODE_BACKUP" "$MIGRATED_OPENCODE"
  if [ -n "$OLD_TARGET" ]; then
    rm -f "$CURRENT_NEXT"
    ln -s "$OLD_TARGET" "$CURRENT_NEXT"
    mv -Tf "$CURRENT_NEXT" "$ROOT/current"
    if install_edge_generation "$ROOT/current"; then
      if [ -n "$EDGE_USER" ]; then
        if [ -n "$ATTEMPTED_EDGE_UNIT_BASE" ] && [ "$ATTEMPTED_EDGE_UNIT_BASE" != "$EDGE_UNIT_BASE" ]; then
          systemctl disable --now "${ATTEMPTED_EDGE_UNIT_BASE}@${EDGE_USER}.service" || true
        fi
        write_edge_home_dropins || true
        systemctl enable "${EDGE_UNIT_BASE}@${EDGE_USER}.service" || true
        systemctl enable --now "mcp-devbox-edge-onboard@${EDGE_USER}.path" || true
        if [ -f "$EDGE_HOME/.local/state/mcp-edge/identity.json" ]; then
          systemctl restart "${EDGE_UNIT_BASE}@${EDGE_USER}.service" || true
        fi
      fi
    else
      echo 'MCP Devbox Edge unit rollback requires manual recovery' >&2
    fi
  else
    rm -f "$ROOT/current"
  fi
  systemctl daemon-reload || true
}
trap rollback_install EXIT INT TERM

rm -f "$CURRENT_NEXT"
ln -s "releases/$RELEASE" "$CURRENT_NEXT"
mv -Tf "$CURRENT_NEXT" "$ROOT/current"

ln -sfn "$ROOT/current/bin/mcp-edge" /usr/local/bin/mcp-edge
ln -sfn "$ROOT/current/libexec/gh" /usr/local/bin/gh
ln -sfn "$ROOT/current/libexec/mcp-autopilot-worker" /usr/local/libexec/mcp-devbox/mcp-autopilot-worker
ln -sfn "$ROOT/current/libexec/mcp-bundle-updater" /usr/local/libexec/mcp-devbox/mcp-bundle-updater
if [ -x "$ROOT/current/libexec/model-turn-driver" ]; then
  ln -sfn "$ROOT/current/libexec/model-turn-driver" /usr/local/libexec/mcp-devbox/model-turn-driver
else
  remove_official_link /usr/local/libexec/mcp-devbox/model-turn-driver "$ROOT/current/libexec/model-turn-driver"
fi
if [ -x "$ROOT/current/libexec/node" ]; then
  ln -sfn "$ROOT/current/libexec/node" /usr/local/libexec/mcp-devbox/node
else
  remove_official_link /usr/local/libexec/mcp-devbox/node "$ROOT/current/libexec/node"
fi
if [ -d "$ROOT/current/opencode-provider" ]; then
  if stage_legacy_directory "$LEGACY_PROVIDER" "$LEGACY_PROVIDER_BACKUP"; then
    MIGRATED_PROVIDER=1
  fi
  ln -sfn "$ROOT/current/opencode-provider" "$LEGACY_PROVIDER"
else
  if stage_legacy_directory "$LEGACY_PROVIDER" "$LEGACY_PROVIDER_BACKUP"; then
    MIGRATED_PROVIDER=1
  fi
  remove_official_link "$LEGACY_PROVIDER" "$ROOT/current/opencode-provider"
fi
if [ -d "$ROOT/current/opencode" ]; then
  if stage_legacy_directory "$LEGACY_OPENCODE" "$LEGACY_OPENCODE_BACKUP"; then
    MIGRATED_OPENCODE=1
  fi
  ln -sfn "$ROOT/current/opencode" "$LEGACY_OPENCODE"
else
  if stage_legacy_directory "$LEGACY_OPENCODE" "$LEGACY_OPENCODE_BACKUP"; then
    MIGRATED_OPENCODE=1
  fi
  remove_official_link "$LEGACY_OPENCODE" "$ROOT/current/opencode"
fi
install_edge_generation "$ROOT/current"
ATTEMPTED_EDGE_UNIT_BASE="$EDGE_UNIT_BASE"

if [ -s /etc/mcp-devbox/edge-user ]; then
  EDGE_USER="$(cat /etc/mcp-devbox/edge-user)"
elif [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
  EDGE_USER="$SUDO_USER"
fi

systemctl daemon-reload
for LEGACY_UNIT in mcp-devbox-edge.service mcp-devbox-opencode-edge.service; do
  LEGACY_STATE="$(systemctl show "$LEGACY_UNIT" --property=LoadState --value)"
  case "$LEGACY_STATE" in
    not-found) ;;
    loaded) systemctl disable --now "$LEGACY_UNIT" ;;
    *) echo 'legacy Edge service state is invalid' >&2; exit 1 ;;
  esac
done
/usr/local/bin/mcp-edge bundle verify
if [ -n "$EDGE_USER" ]; then
	case "$EDGE_USER" in *[!a-z0-9_-]*|'') echo 'invalid Edge user' >&2; exit 1;; esac
	EDGE_HOME="$(getent passwd "$EDGE_USER" | cut -d: -f6)"
	case "$EDGE_HOME" in /*) ;; *) echo 'invalid Edge user home' >&2; exit 1;; esac
	case "$EDGE_HOME" in *[!A-Za-z0-9_./-]*|*/../*|*/..|../*|..) echo 'unsafe Edge user home' >&2; exit 1;; esac
	test -d "$EDGE_HOME"
	write_edge_home_dropins
	printf '%s\n' "$EDGE_USER" >/etc/mcp-devbox/edge-user
	chmod 0600 /etc/mcp-devbox/edge-user
	sed "s/@EDGE_USER@/$EDGE_USER/g" /usr/share/mcp-devbox/49-mcp-devbox-updater.rules.in >/etc/polkit-1/rules.d/49-mcp-devbox-updater.rules
	chmod 0644 /etc/polkit-1/rules.d/49-mcp-devbox-updater.rules
  systemctl daemon-reload
  loginctl enable-linger "$EDGE_USER"
  systemctl --user --machine="${EDGE_USER}@" enable --now podman.socket
  edge_lifecycle recover-state
  MIGRATION_OUTPUT="$(edge_lifecycle prepare-state-migration)"
  case "$MIGRATION_OUTPUT" in
    *"edge_lifecycle migration=prepared"*) STATE_MIGRATION_PREPARED=1 ;;
    *"edge_lifecycle migration=not_needed"*) ;;
    *) echo 'unexpected MCP Devbox Edge migration status' >&2; exit 1 ;;
  esac
  if [ "$EDGE_UNIT_BASE" = 'mcp-devbox-edge' ]; then
    PREVIOUS_EDGE_UNIT="mcp-devbox-opencode-edge@${EDGE_USER}.service"
  else
    PREVIOUS_EDGE_UNIT="mcp-devbox-edge@${EDGE_USER}.service"
  fi
  PREVIOUS_EDGE_STATE="$(systemctl show "$PREVIOUS_EDGE_UNIT" --property=LoadState --value)"
  case "$PREVIOUS_EDGE_STATE" in
    not-found) ;;
    loaded) systemctl disable --now "$PREVIOUS_EDGE_UNIT" ;;
    *) echo 'previous Edge service state is invalid' >&2; exit 1 ;;
  esac
  systemctl enable "${EDGE_UNIT_BASE}@${EDGE_USER}.service"
  systemctl enable --now "mcp-devbox-edge-onboard@${EDGE_USER}.path"
  runuser -u "$EDGE_USER" -- /usr/local/libexec/mcp-devbox/onboarding-preflight
  if [ -f "$EDGE_HOME/.local/state/mcp-edge/identity.json" ]; then
    systemctl restart "${EDGE_UNIT_BASE}@${EDGE_USER}.service"
    systemctl is-active --quiet "${EDGE_UNIT_BASE}@${EDGE_USER}.service"
  fi
  if [ "$STATE_MIGRATION_PREPARED" -eq 1 ]; then
    FINALIZATION_OUTPUT="$(edge_lifecycle finalize-state-migration)"
    case "$FINALIZATION_OUTPUT" in
      *"edge_lifecycle finalization=migrated"*) STATE_MIGRATION_PREPARED=0 ;;
      *) echo 'unexpected MCP Devbox Edge finalization status' >&2; exit 1 ;;
    esac
  fi
fi

if [ "$MIGRATED_PROVIDER" -eq 1 ]; then
  rm -rf "$LEGACY_PROVIDER_BACKUP"
fi
if [ "$MIGRATED_OPENCODE" -eq 1 ]; then
  rm -rf "$LEGACY_OPENCODE_BACKUP"
fi
trap - EXIT INT TERM
exit 0
