# syntax=docker/dockerfile:1.7

FROM public.ecr.aws/docker/library/golang:1.26.10-alpine3.24@sha256:27f2d3b83cfc5803c8078f8e730af0f7c431bf067afaec8f60a36fb763187cba AS build
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/mcp-front-door ./cmd/mcp-front-door
COPY internal/buildinfo ./internal/buildinfo
COPY internal/frontdoor ./internal/frontdoor
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X github.com/charle-z/mcp-devbox/internal/buildinfo.Commit=${GIT_SHA} -X github.com/charle-z/mcp-devbox/internal/buildinfo.BuiltAt=${BUILD_TIME}" \
    -o /out/mcp-front-door ./cmd/mcp-front-door

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates=20260909-r3 ca-certificates-bundle=20260909-r3 curl libbrotlicommon1=1.2.1-r1 libbrotlidec1=1.2.1-r1 libbrotlienc1=1.2.1-r1 libcurl-openssl4=8.23.0-r2 glibc-2.44=2.44-r8 glibc-2.44-locale-posix=2.44-r8 ld-linux-2.44=2.44-r8 libcrypt1-2.44=2.44-r8 libssl3=3.6.5-r1 libcrypto3=3.6.5-r1 \
    && addgroup -S -g 10002 mcpfront \
    && adduser -S -D -H -u 10002 -G mcpfront mcpfront
COPY --from=build /out/mcp-front-door /usr/local/bin/mcp-front-door
USER 10002:10002
EXPOSE 8765
HEALTHCHECK --interval=10s --timeout=10s --start-period=10s --retries=6 \
    CMD curl -fsS --max-time 2 http://127.0.0.1:8765/front-door/healthz >/dev/null || exit 1
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/mcp-front-door"]
