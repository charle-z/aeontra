# syntax=docker/dockerfile:1.7

FROM golang:1.26.5-alpine3.24 AS build
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/mcp-front-door ./cmd/mcp-front-door
COPY internal/buildinfo ./internal/buildinfo
COPY internal/frontdoor ./internal/frontdoor
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X github.com/charle-z/mcp-devbox/internal/buildinfo.Commit=${GIT_SHA} -X github.com/charle-z/mcp-devbox/internal/buildinfo.BuiltAt=${BUILD_TIME}" \
    -o /out/mcp-front-door ./cmd/mcp-front-door

FROM alpine:3.24
RUN apk add --no-cache ca-certificates \
    && addgroup -S mcpfront \
    && adduser -S -D -H -u 10002 -G mcpfront mcpfront
COPY --from=build /out/mcp-front-door /usr/local/bin/mcp-front-door
USER 10002:10002
EXPOSE 8765
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
    CMD wget -qO- http://127.0.0.1:8765/front-door/healthz >/dev/null || exit 1
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/mcp-front-door"]
