FROM golang:1.26.6-alpine3.24@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY cmd/validation-runner ./cmd/validation-runner
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/validation-runner ./cmd/validation-runner

FROM docker:29-cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe
RUN apk add --no-cache curl
COPY --from=build /out/validation-runner /usr/local/bin/validation-runner
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/validation-runner"]
