# MCP Devbox sample deployment configuration
# Copy values into the platform secret/environment manager. Do not source this file
# directly in production and do not commit a populated copy.

# Core runtime: safe defaults
MCP_DEVBOX_ROOT=/repos
MCP_DEVBOX_MODE=read-only
MCP_DEVBOX_STATE_ROOT=/state
MCP_DEVBOX_TASK_ROOT=/state/tasks
MCP_DEVBOX_OBSERVABILITY=file
CONSOLE_TIMEZONE=America/Bogota

# Optional HTTP recovery authentication. Prefer OAuth for the public connector.
# MCP_DEVBOX_TOKEN=REPLACE_WITH_LONG_RANDOM_RECOVERY_VALUE

# Optional OAuth. Set both values together.
# MCP_DEVBOX_PUBLIC_URL=https://mcp.example.com
# MCP_DEVBOX_OAUTH_PASSPHRASE=REPLACE_WITH_LONG_OWNER_PASSPHRASE
# MCP_DEVBOX_OAUTH_CLIENT_STORE=/state/oauth-clients.json
# MCP_DEVBOX_OAUTH_ACCESS_STORE=/state/oauth-access.json
# MCP_DEVBOX_OAUTH_REFRESH_STORE=/state/oauth-refresh.json

# Optional command/test configuration. Keep the allowlist narrow.
# MCP_DEVBOX_TEST_CMD=go test ./... -count=1
# MCP_DEVBOX_ALLOW_CMD=git,go

# Optional persistent Brain. Requires a dedicated /brain volume outside /repos.
# MCP_DEVBOX_BRAIN_ROOT=/brain

# Optional GitHub API authority.
# GITHUB_TOKEN=REPLACE_WITH_FINE_GRAINED_GITHUB_VALUE
# Optional separate user credential for public OSS repositories owned by third
# parties. It is used only for /repos/<external-owner>/... API routes.
# GITHUB_OSS_TOKEN=REPLACE_WITH_GITHUB_USER_VALUE
# GITHUB_OWNER=example-owner
# GITHUB_OWNER_TYPE=user
# GITHUB_DEFAULT_VISIBILITY=private

# Optional Coolify authority.
# COOLIFY_URL=https://coolify.example.com
# COOLIFY_API_TOKEN=REPLACE_WITH_COOLIFY_API_VALUE
# COOLIFY_ALLOWED_APPS=example-application-uuid
# COOLIFY_SERVER_UUID=example-server-uuid
# COOLIFY_PROJECT_UUID=example-project-uuid
# COOLIFY_ENVIRONMENT_NAME=production
# COOLIFY_ALLOWED_DOMAINS=example.com

# Optional private validation runner connection.
# MCP_DEVBOX_VALIDATION_RUNNER_URL=http://validation-runner:8787
# MCP_DEVBOX_VALIDATION_RUNNER_TOKEN=REPLACE_WITH_SHARED_RUNNER_VALUE

# Fixed privileged profiles are disabled unless an administrator deliberately opts in.
MCP_DEVBOX_PRIVILEGED_TASKS=false
# MCP_DEVBOX_PRIVILEGED_SERVICES=mcp-devbox
# MCP_DEVBOX_PRIVILEGED_TIMEOUT=2m
