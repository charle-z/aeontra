FROM cgr.dev/chainguard/wolfi-base@sha256:6a8dca4c2153cfc11d559cfa6172c187b896423d833f3d48a4c1c44ab55596d7
RUN apk add --no-cache \
      bash=5.3-r12 \
      build-base=1-r9 \
      ca-certificates=20260413-r1 \
      git=2.55.0-r4 \
      glibc-2.44=2.44-r6 \
      glibc-2.44-dev=2.44-r6 \
      glibc-2.44-locale-posix=2.44-r6 \
      go-1.26=1.26.7-r0 \
      jq=1.8.2-r1 \
      ld-linux-2.44=2.44-r6 \
      libcrypt1-2.44=2.44-r6 \
      nodejs-24=24.19.0-r0 \
      npm=12.0.2-r0 \
      py3-pip=26.2.1-r0 \
      python-3.14=3.14.7-r6 \
      rust-1.96=1.96.1-r0 \
      zlib=1.3.2-r7
RUN zlib_commit=4d03c63b8648ab83053a6f00d304a5d6f9aa1ed7 \
 && zlib_archive=/tmp/zlib-${zlib_commit}.tar.gz \
 && python3 -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' \
      "https://codeload.github.com/madler/zlib/tar.gz/${zlib_commit}" "$zlib_archive" \
 && printf '%s  %s\n' b4d20a2c640eb3bc3fba2d41931076ff6523826defffcaf45292991520e2623a "$zlib_archive" \
      | busybox sha256sum -c - \
 && busybox tar -xzf "$zlib_archive" -C /tmp \
 && cd "/tmp/zlib-${zlib_commit}" \
 && ./configure --prefix=/usr \
 && make -j1 \
 && make test \
 && make install \
 && cc -I/usr/include test/gznonblock.c -L/usr/lib -Wl,-rpath,/usr/lib -lz -o /tmp/zlib-gznonblock \
 && /tmp/zlib-gznonblock \
 && mkdir -p /usr/share/aeontra/security \
 && printf '%s\n' "$zlib_commit" > /usr/share/aeontra/security/zlib-gzwrite-fix \
 && rm -rf "$zlib_archive" "/tmp/zlib-${zlib_commit}" /tmp/zlib-gznonblock
RUN brace_archive=/tmp/brace-expansion-5.0.9.tgz \
 && ip_archive=/tmp/ip-address-10.3.1.tgz \
 && NPM_CONFIG_CACHE=/tmp/npm-cache npm pack --ignore-scripts --pack-destination /tmp brace-expansion@5.0.9 \
 && NPM_CONFIG_CACHE=/tmp/npm-cache npm pack --ignore-scripts --pack-destination /tmp ip-address@10.3.1 \
 && printf '%s  %s\n' 5d06001fddd25cbee90c96db4dc5b7b57711b984c3141e28d10f143deb52dbaf "$brace_archive" \
      | busybox sha256sum -c - \
 && printf '%s  %s\n' ad1790063beea11a312c801df30d58e147de762f4f77787552376eb7424623e5 "$ip_archive" \
      | busybox sha256sum -c - \
 && mkdir -p /tmp/brace-unpack /tmp/ip-unpack \
 && busybox tar -xzf "$brace_archive" -C /tmp/brace-unpack \
 && busybox tar -xzf "$ip_archive" -C /tmp/ip-unpack \
 && rm -rf /usr/lib/node_modules/npm/node_modules/brace-expansion \
             /usr/lib/node_modules/npm/node_modules/ip-address \
 && mkdir -p /usr/lib/node_modules/npm/node_modules/brace-expansion \
             /usr/lib/node_modules/npm/node_modules/ip-address \
 && cp -a /tmp/brace-unpack/package/. /usr/lib/node_modules/npm/node_modules/brace-expansion/ \
 && cp -a /tmp/ip-unpack/package/. /usr/lib/node_modules/npm/node_modules/ip-address/ \
 && test "$(node -p "require('/usr/lib/node_modules/npm/node_modules/brace-expansion/package.json').version")" = 5.0.9 \
 && test "$(node -p "require('/usr/lib/node_modules/npm/node_modules/ip-address/package.json').version")" = 10.3.1 \
 && rm -rf "$brace_archive" "$ip_archive" /tmp/brace-unpack /tmp/ip-unpack /tmp/npm-cache
WORKDIR /workspace
CMD ["/bin/bash"]
